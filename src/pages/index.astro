---
import { ArrowUpRight, Search } from "lucide-astro";
import manifest from "../generated/manifest.json";
import CategoryTabs from "../components/hub/CategoryTabs.astro";
import ProjectCard from "../components/hub/ProjectCard.astro";
import HubLayout from "../layouts/HubLayout.astro";
import type { ManifestProject, SiteConfig } from "../utils/manifest";
import { buildHubJsonLd } from "../utils/seo";

const projects = manifest.projects as ManifestProject[];
const totalPages = projects.reduce(
  (sum, project) => sum + (Array.isArray(project.flatPages) ? project.flatPages.length : 0),
  0,
);
const searchLabel =
  totalPages > 0
    ? `Search ${totalPages} docs across ${projects.length} ${projects.length === 1 ? "project" : "projects"}...`
    : "Search documentation...";
const developerEndpoints = [
  { label: "/llms.txt", note: "AI index", href: "/llms.txt" },
  { label: "/llms-full.txt", note: "Full docs", href: "/llms-full.txt" },
  { label: "vibtools-docs.schema.json", note: ".vibtools spec", href: "/schemas/vibtools-docs.schema.json" },
];
const hubJsonLd = buildHubJsonLd(manifest.site as SiteConfig);
---

<HubLayout site={manifest.site} projects={projects} structuredData={hubJsonLd}>
  <main id="main-content" class="mx-auto w-full max-w-6xl flex-1 px-4 sm:px-6 lg:px-8">
    <section class="border-b border-[var(--border-hairline)] py-5 sm:py-6" aria-labelledby="portal-title">
      <div class="grid grid-cols-1 items-start gap-5 lg:grid-cols-[minmax(0,1fr)_21rem] lg:items-center lg:gap-8">
        <div class="min-w-0">
          <h1 id="portal-title" class="max-w-2xl text-2xl font-semibold leading-tight tracking-normal text-[var(--text-primary)] sm:text-[26px] [text-wrap:balance]">
            {manifest.site.portalTitle}
          </h1>
          <p class="mt-1.5 max-w-xl text-sm leading-6 text-[var(--text-muted)]">
            {manifest.site.portalSubtitle}
          </p>

          <div class="mt-4 flex flex-wrap items-center gap-3">
            <button
              type="button"
              data-search-trigger
              aria-label="Open documentation search"
              class="flex h-10 w-full cursor-pointer items-center justify-between gap-3 rounded-md border border-[var(--border-hairline)] bg-[var(--bg-surface)] px-3 text-xs text-[var(--text-muted)] transition-colors hover:border-[var(--accent-color)]/60 hover:bg-[var(--bg-hover)] hover:text-[var(--text-primary)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--accent-color)] sm:max-w-md"
            >
              <span class="flex min-w-0 items-center gap-2">
                <Search class="size-3.5 shrink-0 text-[var(--accent-color)]" aria-hidden="true" />
                <span class="truncate font-normal text-[var(--text-primary)]">{searchLabel}</span>
              </span>
              <kbd class="hidden shrink-0 rounded border border-[var(--border-hairline)] bg-[var(--bg-canvas)] px-1.5 py-px font-mono text-[10px] leading-4 text-[var(--text-muted)] sm:inline-flex">Ctrl K</kbd>
            </button>
          </div>
        </div>

        <aside class="rounded-lg border border-[var(--border-hairline)] bg-[var(--bg-surface)]" aria-label="Developer endpoints">
          <div class="flex items-center justify-between gap-3 border-b border-[var(--border-hairline)] px-3 py-1.5">
            <span class="text-xs font-medium text-[var(--text-primary)]">Developer Endpoints</span>
            <span class="font-mono text-[11px] tabular-nums text-[var(--text-muted)]">
              {projects.length} {projects.length === 1 ? "repo" : "repos"} · {totalPages} pages
            </span>
          </div>
          <ul class="divide-y divide-[var(--border-hairline)]">
            {developerEndpoints.map((endpoint) => (
              <li>
                <a
                  href={endpoint.href}
                  class="group flex items-center justify-between gap-3 px-3 py-2 text-xs text-inherit no-underline transition-colors hover:bg-[var(--bg-hover)] focus-visible:outline-2 focus-visible:outline-offset-[-2px] focus-visible:outline-[var(--accent-color)]"
                >
                  <span class="min-w-0 truncate font-mono text-[11.5px] font-medium text-[var(--text-primary)] group-hover:text-[var(--accent-color)]">
                    {endpoint.label}
                  </span>
                  <span class="flex shrink-0 items-center gap-1 text-[11px] text-[var(--text-muted)]">
                    <span>{endpoint.note}</span>
                    <ArrowUpRight class="size-3 shrink-0 opacity-60 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5 group-hover:text-[var(--accent-color)] group-hover:opacity-100" aria-hidden="true" />
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </aside>
      </div>
    </section>

    <section class="py-5 sm:py-6" aria-labelledby="projects-heading">
      <div class="mb-3 flex items-baseline justify-between gap-4">
        <h2 id="projects-heading" class="text-sm font-medium text-[var(--text-primary)]">Documentation</h2>
        <span class="text-xs tabular-nums text-[var(--text-muted)]">
          {projects.length} {projects.length === 1 ? "project" : "projects"}
        </span>
      </div>

      <CategoryTabs categories={manifest.categories} />

      {projects.length > 0 ? (
        <div class="grid grid-cols-1 gap-3.5 sm:grid-cols-2 lg:grid-cols-3">
          {projects.map((project) => <ProjectCard project={project} />)}
        </div>
      ) : (
        <p class="rounded-md border border-[var(--border-hairline)] bg-[var(--bg-surface)] px-4 py-6 text-sm text-[var(--text-muted)]">
          No documentation projects are available yet.
        </p>
      )}

      <p class="mt-4 text-sm text-[var(--text-muted)]" data-filter-empty hidden role="status" aria-live="polite">
        No projects match this category.
      </p>
    </section>
  </main>
</HubLayout>
